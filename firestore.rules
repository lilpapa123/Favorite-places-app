rules_version = '2';

// Favorite Places: profiles, usernames, follows, shared places and chats.
// Review against the project's current rules before deploying: deploying
// replaces ALL Firestore rules in the project.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The app allows 150 visible characters. size() counts UTF-16 units and
    // the longest standard emoji takes 15, hence 150 * 15.
    function validBio(data) {
      return !('bio' in data) || (data.bio is string && data.bio.size() <= 2250);
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function claimPath(name) {
      return /databases/$(database)/documents/usernames/$(name);
    }

    // A profile shows a username only if that name's claim is this user's
    // once the whole transaction has been applied.
    function ownsUsername(uid, data) {
      return (!('username' in data) && !('usernameLower' in data))
        || (data.username is string
          && data.username.matches('^[a-zA-Z0-9._]{3,20}$')
          && data.usernameLower == data.username.lower()
          && getAfter(claimPath(data.usernameLower)).data.uid == uid);
    }

    // Leaving a username gives up its claim, so names can't be hoarded.
    function releasedOldClaim() {
      return !('usernameLower' in resource.data)
        || !existsAfter(claimPath(resource.data.usernameLower));
    }

    function keepsUsername() {
      return 'usernameLower' in resource.data
        && 'usernameLower' in request.resource.data
        && resource.data.usernameLower == request.resource.data.usernameLower;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isMe(uid)
        && validBio(request.resource.data)
        && ownsUsername(uid, request.resource.data);
      allow update: if isMe(uid)
        && validBio(request.resource.data)
        && ownsUsername(uid, request.resource.data)
        && (keepsUsername() || releasedOldClaim());
      allow delete: if isMe(uid) && releasedOldClaim();

      // I manage who I follow.
      match /following/{other} {
        allow read: if signedIn();
        allow write: if isMe(uid);
      }

      // Each follower adds or removes only their own entry.
      match /followers/{other} {
        allow read: if signedIn();
        allow write: if isMe(other);
      }
    }

    // One document per username. A claim and the profile showing it are
    // created and released together, in one transaction (Social.saveProfile).
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(profilePath(request.auth.uid)).data.usernameLower == name;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && (!existsAfter(profilePath(request.auth.uid))
          || getAfter(profilePath(request.auth.uid)).data.get('usernameLower', '') != name);
    }

    match /places/{placeId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Anyone signed in may comment as themselves; only the writer deletes.
      // The app allows 500 visible characters, 15 UTF-16 units per emoji.
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 7500
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/places/$(placeId));
        allow update: if false;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    // A chat between two people. Its id is their uids, sorted, joined by
    // '_', so only those two can open it. The app allows 1000 visible
    // characters per message, 15 UTF-16 units per emoji.
    match /chats/{chatId} {
      allow get: if signedIn() && request.auth.uid in chatId.split('_');
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create, update: if signedIn()
        && request.auth.uid in chatId.split('_')
        && request.resource.data.keys().hasOnly(['members', 'lastText', 'lastAt'])
        && request.resource.data.members == chatId.split('_')
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] != request.resource.data.members[1]
        && request.resource.data.lastText is string
        && request.resource.data.lastText.size() <= 15000
        && request.resource.data.lastAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in chatId.split('_');
        allow create: if signedIn()
          && request.auth.uid in chatId.split('_')
          && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 15000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
